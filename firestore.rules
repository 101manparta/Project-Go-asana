rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'ADMIN' || request.auth.token.role == 'SUPER_ADMIN');
    }
    
    // Classes & Instructors: Public read, Admin write
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Sessions: Public read, mutations through backend only
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Bookings: Strict customer access & backend server mutation
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      // Direct client creation forbidden: MUST route through Go backend transaction
      allow create, update, delete: if isAdmin();
    }
    
    // User Profiles: Users read and edit their own non-role profile fields
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'remainingCredits', 'accountStatus']);
      allow create, delete: if isAdmin();
    }
    
    // Studio Settings & Audit Logs
    match /studio_settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
